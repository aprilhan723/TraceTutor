# TraceTutor runs in local Demo Mode when these values are absent.
# Use only the Project URL and publishable key from Supabase's Connect dialog.
# Never add a secret/service-role key to this file or to NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_APP_URL=http://localhost:3000
