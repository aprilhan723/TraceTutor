# TraceTutor runs in local Demo Mode when these values are absent.
# Use only the Project URL and publishable key from Supabase's Connect dialog.
# Never add a secret/service-role key to this file or to NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Keep email-link auth off until a dedicated SMTP provider is configured.
# Set confirmation required to match Supabase Authentication settings.
TRACETUTOR_EMAIL_LINK_AUTH_ENABLED=false
TRACETUTOR_EMAIL_CONFIRMATION_REQUIRED=true

# Optional server-only diagnosis assist. Deterministic rules and tutor review
# remain fully functional with this disabled. OPENAI_API_KEY is intentionally
# omitted from this public template; save it only through the secure credential flow.
TRACETUTOR_LIVE_AI_ENABLED=false
TRACETUTOR_OPENAI_MODEL=gpt-5.6-luna
