{
  "name": "tracetutor",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:ai": "vitest run src/ai",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:rls": "node scripts/verify-rls.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "description": "Open-source, tutor-verified mistake-correction workspace for evidence-led TOEFL Reading practice.",
  "license": "MIT",
  "homepage": "https://project-qiel2.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/aprilhan723/TraceTutor.git"
  },
  "bugs": {
    "url": "https://github.com/aprilhan723/TraceTutor/issues"
  }
}
